# Copy to .env.local for development. Never commit real values.

# PostgreSQL the app connects to (local development database; see `npm run db:dev`).
DATABASE_URL=postgres://postgres@localhost:54329/zimerp_dev

# Domain the platform runs on. Companies get <slug>.<domain> and erp.<slug>.<domain>.
ZIMERP_PLATFORM_DOMAIN=zimerp.co.zw

# Sign-in: "dev" (email only, refused in production) or "supabase" (email and
# password through Supabase Auth; see docs/supabase-setup.md). With "supabase",
# DATABASE_URL must be the same Supabase project's database.
AUTH_MODE=dev

# Signs session cookies. At least 32 random characters; required in production.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Supabase: project address and public (anon / publishable) key, used for
# sign-in and routing lookups. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never in the browser: invitations (Supabase emails the link)
# and file storage. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Uploaded files: "supabase" (Supabase Storage, private bucket below) or
# "filesystem" (STORAGE_DIR). Unset: Supabase when the key above is set.
STORAGE=
SUPABASE_STORAGE_BUCKET=zimerp-files

# Protects /api/cron/* (events every minute, daily-summary every 15 minutes, billing daily).
CRON_SECRET=

# ZimERP's own Paynow account, for companies paying their subscription (P11).
# Without them (or with ADAPTERS=fake) a test checkout is used outside production.
PAYNOW_ZIMERP_INTEGRATION_ID=
PAYNOW_ZIMERP_INTEGRATION_KEY=

# Limits on public forms (enquiries, checkout, sign-in, sign-up). Leave on;
# "off" is only for automated browser tests that sign in many times.
RATE_LIMITS=on

# Own domains. Where companies point their DNS: a CNAME target for names like
# www.mybusiness.co.zw and an IP address for bare names (mybusiness.co.zw).
ZIMERP_CNAME_TARGET=
ZIMERP_APEX_IP=
# Hosting provider that attaches domains with SSL (fake when unset).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Registering domains for companies: "manual" (ZimERP staff complete orders
# at name.co.zw) or "fake" (registers at once, for demos and tests).
DOMAIN_REGISTRAR=manual
# How long the router remembers a hostname lookup (milliseconds).
SITE_LOOKUP_CACHE_MS=60000

# Test mode before the platform domain is bought: one address serves every
# company (/erp/<name>, /site/<name>). Leave empty with a real domain.
ZIMERP_SINGLE_HOST=
